                  "        pm.environment.set('loggedInUserId', jsonData.data.user.id);",
                  "        pm.environment.set('loggedInUserEmail', jsonData.data.user.email);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
