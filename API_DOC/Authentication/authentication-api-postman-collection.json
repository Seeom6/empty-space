              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/website/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "website", "auth", "login"]
            },
            "description": "Authenticates a user with email and password."
          }
        },
        {
          "name": "2.2 Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has new access token', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.have.property('accessToken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "refreshToken={{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/website/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "website", "auth", "refresh"]
            },
            "description": "Refreshes the access token using the refresh token."
          }
        },
        {
          "name": "2.3 Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has logout message', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.have.property('message');",
                  "});",
                  "",
                  "// Clear stored tokens",
                  "pm.environment.unset('accessToken');",
                  "pm.environment.unset('refreshToken');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "accessToken={{accessToken}}; refreshToken={{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/website/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "website", "auth", "logout"]
            },
            "description": "Logs out the user and invalidates tokens."
          }
        }
      ],
      "description": "User authentication endpoints"
    },
