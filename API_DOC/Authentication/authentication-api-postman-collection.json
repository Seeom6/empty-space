{
  "info": {
    "name": "Empty Space Authentication API",
    "description": "Comprehensive authentication API collection for Empty Space application including multi-step registration, login, password reset, and admin operations.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set base URL if not already set",
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost:12001');",
          "}",
          "",
          "// Generate request ID for tracking",
          "pm.environment.set('requestId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test for all requests",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Extract and save cookies",
          "if (pm.response.headers.get('Set-Cookie')) {",
          "    const cookies = pm.response.headers.get('Set-Cookie').split(',');",
          "    cookies.forEach(cookie => {",
          "        const [nameValue] = cookie.split(';');",
          "        const [name, value] = nameValue.split('=');",
          "        if (name && value && name.trim() !== '' && value.trim() !== '') {",
          "            pm.environment.set(name.trim(), value.trim());",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:12001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Registration Flow",
      "item": [
        {
          "name": "1.1 Validate Invite Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.have.property('message');",
                  "    pm.expect(jsonData.data).to.have.property('sessionToken');",
                  "});",
                  "",
                  "// Save session token for next requests",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data.sessionToken) {",
                  "        pm.environment.set('sessionToken', jsonData.data.sessionToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"{{inviteCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/website/auth/validate-invite-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "website", "auth", "validate-invite-code"]
            },
            "description": "Validates an employee invite code and initiates the registration session."
          }
        },
        {
          "name": "1.2 Register Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.have.property('message');",
                  "    pm.expect(jsonData.data).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "sessionToken={{sessionToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/website/auth/register-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "website", "auth", "register-email"]
            },
            "description": "Registers user email and sends OTP for verification."
          }
        },
        {
          "name": "1.3 Verify Registration OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "otpToken={{otpToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/website/auth/verify-registration-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "website", "auth", "verify-registration-otp"]
            },
            "description": "Verifies the OTP sent to user's email during registration."
          }
        },
        {
          "name": "1.4 Complete Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has user data', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.have.property('user');",
                  "    pm.expect(jsonData.data).to.have.property('accessToken');",
                  "});",
                  "",
                  "// Save user data for future requests",
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data.user) {",
                  "        pm.environment.set('userId', jsonData.data.user.id);",
                  "        pm.environment.set('userEmail', jsonData.data.user.email);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "registrationToken={{registrationToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{testPassword}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/website/auth/complete-registration",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "website", "auth", "complete-registration"]
            },
            "description": "Completes the registration process by setting password and optional phone number."
          }
        }
      ],
      "description": "Multi-step registration flow for new employees"
    },
    {
